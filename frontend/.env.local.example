# CryptoTrace LEA Next.js Frontend Environment Configuration
# Notice: Do NOT expose private keys, RPC keys, or backend secrets in NEXT_PUBLIC_ variables.

# URL of the FastAPI Backend
NEXT_PUBLIC_API_URL=http://localhost:8765
BACKEND_URL=http://127.0.0.1:8765

# Application Environment Mode: 'development' | 'staging' | 'production'
NEXT_PUBLIC_APP_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_DEBUG_PANEL=true
NEXT_PUBLIC_ENABLE_AI_COPILOT=true
